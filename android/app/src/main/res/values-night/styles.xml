<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- التطبيق فاتح دائماً (لا وضع داكن)؛ وشاشة البدء كحلية في الوضعين
         حتى تتصل بسلاسة مع غلاف «سنتر الشطرة» الكحلي داخل التطبيق.
         (النسخة الأقدم كانت Theme.Black وهو سبب الشاشة السوداء.) -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/launch_navy</item>
        <item name="android:navigationBarColor">@color/launch_navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_navy</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/launch_navy</item>
        <item name="android:navigationBarColor">@color/launch_navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
