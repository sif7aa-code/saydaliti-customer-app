<?xml version="1.0" encoding="utf-8"?>
<!--
  شاشة بدء أندرويد 12+ (SplashScreen API).
  الخلفية كحلية عميقة مثل شاشة البداية «سنتر الشطرة» داخل التطبيق
  (كانت بيضاء فتُومض وميضاً أبيض قبل الغلاف الكحلي).
-->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/launch_navy</item>
        <!-- أيقونة شفافة: إخفاء لوكو الأيقونة من شاشة البداية -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/transparent_splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launch_navy</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/launch_navy</item>
        <item name="android:navigationBarColor">@color/launch_navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_navy</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/launch_navy</item>
        <item name="android:navigationBarColor">@color/launch_navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
