PORT=3000
HOST=127.0.0.1

APP_API_KEY=
ADMIN_KEY=

WHATSAPP_DRY_RUN=

COUNTRY_CODE=964
BRAND_NAME=سنتر الشطرة
CODE_LENGTH=4
CODE_TTL_MINUTES=5
RESEND_COOLDOWN_SECONDS=60
MAX_CODES_PER_PHONE_PER_HOUR=2
MAX_CODES_TOTAL_PER_HOUR=60
MAX_VERIFY_ATTEMPTS=5

SESSION_DIR=/opt/qrlogn/data/session
DATA_DIR=/opt/qrlogn/data

# ---------------------------------------------------------------------
#  تشفير على القرص
#  WA_SESSION_KEY : إلزامي. مفتاح 32 بايت base64 لجلسات واتساب.
#                   بدونه يرفض الخادم التشغيل (fail closed) حتى لا
#                   تُكتب الجلسات نصاً صريحاً.
#  WA_KEYS_KEY    : اختياري. يشفّر keys.json (مفتاح توقيع رموز الدخول).
#                   بدونه تحذير فقط.
#  توليد مفتاح:
#    node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
#  ★ احتفظ بالمفتاح في مدير كلمات مرور. ضياعه = فقدان جلسة واتساب،
#    وتعذّر فكّ أي نسخة احتياطية أُخذت قبله.
#  ★ انسخه إلى السيرفر عبر:
#      printf 'WA_SESSION_KEY=%s\n' '<key>' >> /opt/qrlogn/.env
#    ولا تضعه في Git ولا في السكربتات.
# ---------------------------------------------------------------------
WA_SESSION_KEY=
WA_KEYS_KEY=

